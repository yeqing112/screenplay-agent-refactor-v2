    "authorization": "DIRECTOR_BEAT_PLAN_AUTHORIZATION_ID_REQUIRED"
  },
  "next_state": "DIRECTOR_CREATIVE_ENRICHMENT_AUTHORIZATION_REQUIRED"
}

{
  "reconciliation": {
    "candidate_content_fingerprint": "ea83de61dddd12842ea319e367f284a620bad83ad2c8643b65d331aa003db1c8",
    "candidate_projection_authoritative": true,
    "candidate_timeline": [
      {
        "source_type": "SOURCE_ACTION",
        "text": "顾沉带林晚进入暗房。",
        "timeline_ordinal": 1
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "红色安全灯忽明忽暗，墙上的水渍像一张张倒置的地图。",
        "timeline_ordinal": 2
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "暗房中央摆着一只铁盒，盒盖上贴着母亲的手写标签：第七次潮汐。",
        "timeline_ordinal": 3
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "铁盒是空的，只有一小段烧焦的胶片和一枚海鸥别针。",
        "timeline_ordinal": 4
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "林晚认出别针与照片里小女孩佩戴的一模一样，却想不起自己童年是否来过这里。",
        "timeline_ordinal": 5
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "顾沉说胶片被人拿走了。",
        "timeline_ordinal": 6
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "林晚问是谁",
        "timeline_ordinal": 7
      },
      {
        "source_type": "SOURCE_DIALOGUE",
        "speaker": "顾沉",
        "text": "也许是你自己",
        "timeline_ordinal": 8
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "两人同时听见门外铜铃响了一声，顾沉熄灭安全灯，拉着林晚躲到药水柜后。",
        "timeline_ordinal": 9
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "门缝下出现一双湿透的皮鞋。",
        "timeline_ordinal": 10
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "那人没有进门，只把一张车票塞进来。",
        "timeline_ordinal": 11
      },
      {
        "source_type": "SOURCE_ACTION",
        "text": "车票背面写着：今晚十点，北堤仓库，带钥匙，不要带顾沉。",
        "timeline_ordinal": 12
      }
    ],

  "source_units": [
    {
      "unit_id": "SAU_ACTION_001",
      "source_type": "SOURCE_ACTION",
      "source_order": 1,
      "text": "顾沉带林晚进入暗房。"
    },
    {
      "unit_id": "SAU_ACTION_002",
      "source_type": "SOURCE_ACTION",
      "source_order": 2,
      "text": "红色安全灯忽明忽暗，墙上的水渍像一张张倒置的地图。"
    },
    {
      "unit_id": "SAU_ACTION_003",
      "source_type": "SOURCE_ACTION",
      "source_order": 3,
      "text": "暗房中央摆着一只铁盒，盒盖上贴着母亲的手写标签：第七次潮汐。"
    },
    {
      "unit_id": "SAU_ACTION_004",
      "source_type": "SOURCE_ACTION",
      "source_order": 4,
      "text": "铁盒是空的，只有一小段烧焦的胶片和一枚海鸥别针。"
    },
    {
      "unit_id": "SAU_ACTION_005",
      "source_type": "SOURCE_ACTION",
      "source_order": 5,
      "text": "林晚认出别针与照片里小女孩佩戴的一模一样，却想不起自己童年是否来过这里。"
    },
    {
      "unit_id": "SAU_ACTION_006",
      "source_type": "SOURCE_ACTION",
      "source_order": 6,
      "text": "两人同时听见门外铜铃响了一声，顾沉熄灭安全灯，拉着林晚躲到药水柜后。"
    },
    {
      "unit_id": "SAU_ACTION_007",
      "source_type": "SOURCE_ACTION",
      "source_order": 7,
      "text": "门缝下出现一双湿透的皮鞋。"
    },
    {
      "unit_id": "SAU_ACTION_008",
      "source_type": "SOURCE_ACTION",
      "source_order": 8,
      "text": "那人没有进门，只把一张车票塞进来。"
    },
    {
      "unit_id": "SAU_ACTION_009",
      "source_type": "SOURCE_ACTION",
      "source_order": 9,
      "text": "车票背面写着：今晚十点，北堤仓库，带钥匙，不要带顾沉。"
    },
    {
      "unit_id": "SAU_DIALOGUE_001",
      "source_type": "SOURCE_DIALOGUE",
      "source_order": 1,
      "speaker": "顾沉",
      "text": "胶片被人拿走了。"
    },
    {
      "unit_id": "SAU_DIALOGUE_002",
      "source_type": "SOURCE_DIALOGUE",
      "source_order": 2,
      "speaker": "林晚",
      "text": "是谁"
    },
    {
      "unit_id": "SAU_DIALOGUE_003",
      "source_type": "SOURCE_DIALOGUE",
      "source_order": 3,
      "speaker": "顾沉",
      "text": "也许是你自己"
    }
  ]

      "actions": [
        {
          "action_id": "A001",
          "text": "林晚站在售票窗前，额角有汗，攥紧旧皮包。",
          "beat_ref": "SC01-B01"
        },
        {
          "action_id": "A002",
          "text": "林晚看向站台。一把收起的红伞斜靠在立柱旁。",
          "beat_ref": "SC01-B03"
        },
        {
          "action_id": "A003",
          "text": "林晚的手提包掉落，搭扣弹开，露出一截断裂的暗红色伞骨。",
          "beat_ref": "SC01-B04"
        },
        {
          "action_id": "A004",
          "text": "陆叔从侧面快步走来，手里拎着网兜，接过林晚的手提包，掂了掂。",
          "beat_ref": "SC01-B07"
        },
        {
          "action_id": "A005",
          "text": "站台立柱旁的红伞不见了，只留下一小片深色水渍。",
          "beat_ref": "SC01-B09"
        },
        {
          "action_id": "A006",
          "text": "林晚低头看向手提包。包扣的位置不对。她打开包。断裂的暗红色伞骨不见了。",
          "beat_ref": "SC01-B10"
        },
        {
          "action_id": "A007",
          "text": "林晚抬起眼，看向陆叔。",
          "beat_ref": "SC01-B10"
        },
        {
          "action_id": "A008",
          "text": "陆叔没有劝她登车，反而立刻点头答应回去。",
          "beat_ref": "SC01-B12"
        },
        {
          "action_id": "A009",
          "text": "顾沉低声说完，走进人群，消失不见。",
          "beat_ref": "SC01-B13"
        }
      ],
      "dialogues": [
        {
          "dialogue_id": "D001",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "两张去南城的票。最早一班。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D002",
          "speaker": "售票员",
          "parenthetical": "",
          "text": "最近一班，十点十五。硬座还是卧铺？",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D003",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "卧铺……下铺。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D004",
          "speaker": "顾沉",
          "parenthetical": "",
          "text": "林晚。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D005",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "顾沉？你……你怎么在这儿？",
          "assertion_mode": "UNCERTAIN_CLAIM",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D006",
          "speaker": "顾沉",
          "parenthetical": "",
          "text": "路过。看到你，打个招呼。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D007",
          "speaker": "顾沉",
          "parenthetical": "",
          "text": "要出门？南城？",
          "assertion_mode": "CHARACTER_BELIEF",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D008",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "嗯，办点事。",
          "assertion_mode": "CHARACTER_BELIEF",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D009",
          "speaker": "顾沉",
          "parenthetical": "",
          "text": "那把伞，挺眼熟的。红色。伞骨好像断过。修补过，但没修好。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": true,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D010",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "什么伞？我不……",
          "assertion_mode": "CHARACTER_BELIEF",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D011",
          "speaker": "陆叔",
          "parenthetical": "",
          "text": "小晚！可算找到你了！你陆婶非让我给你塞这点路上吃的，说南城那边水果贵……",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D012",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "……朋友。顾沉。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D013",
          "speaker": "陆叔",
          "parenthetical": "",
          "text": "红伞？没注意。下雨了？这天儿，是该带伞。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D014",
          "speaker": "林晚",
          "parenthetical": "",
          "text": "陆叔，你的伞呢？",
          "assertion_mode": "QUESTION",
          "contradicts_fact_refs": [],
          "audience_should_notice": false,
          "character_knowledge_ref": ""
        },
        {
          "dialogue_id": "D015",
          "speaker": "陆叔",
          "parenthetical": "",
          "text": "没带啊。这不下雨，带啥伞。你这孩子，问东问西的。",
          "assertion_mode": "OBJECTIVE_FACT",
          "contradicts_fact_refs": [],

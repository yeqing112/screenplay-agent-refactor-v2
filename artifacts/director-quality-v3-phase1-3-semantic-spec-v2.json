    "spatial_expression",
    "prop_visual_strategy",
    "shot_architecture_guidance",
    "must_preserve",
    "must_avoid",
    "creative_risks"
  ],
  "information_fields": [
    "reveal_refs",
    "hint_refs",
    "withhold_refs",
    "audience_suspicions",
    "director_inferences"
  ],
  "epistemic_types": [
    "SOURCE_FACT",
    "DIRECTOR_INFERENCE",
    "AUDIENCE_SUSPICION",

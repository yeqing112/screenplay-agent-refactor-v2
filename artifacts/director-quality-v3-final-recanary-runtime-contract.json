      "beats": {
        "B1": {
          "beat_id": "B1",
          "dramatic_function": "引入第一个视觉谜团，暗示昨夜有人活动。",
          "emotion_change": "林晚从慵懒转为警觉。",
          "event": "林晚发现暗房门口地板上有新鲜湿润的拖痕，延伸至储物柜前。",
          "information_change": "林晚获知昨夜暗房区域有异常活动。",
          "type": "发现"
        },
        "B2": {
          "beat_id": "B2",
          "dramatic_function": "强化异常，暗示有人翻动过相册夹并可能取走了内容物。",
          "emotion_change": "林晚的怀疑加深。",
          "event": "林晚检查储物柜，发现黑色皮质相册夹位置异常（横倒、搭扣打开、有新鲜划痕），且内部为空。",
          "information_change": "林晚确认相册夹被动过，内容物丢失。",
          "type": "调查"
        },
        "B3": {
          "beat_id": "B3",
          "dramatic_function": "首次暗示林晚自身也藏有秘密（旧照片）。",
          "emotion_change": "林晚在调查中保持表面镇定。",
          "event": "林晚放回相册夹时，无意识地摸了一下自己毛衣左侧口袋（内藏方形物体）。",
          "information_change": "观众获知林晚口袋藏有物品。",
          "type": "隐藏"
        },
        "B4": {
          "beat_id": "B4",
          "dramatic_function": "引入另一角色，开始表面正常的互动，为后续试探铺垫。",
          "emotion_change": "林晚迅速恢复慵懒面具；顾沉表现困倦。",
          "event": "顾沉带着早餐进入照相馆，与林晚进行日常对话。",
          "information_change": "顾沉出现，提及“昨晚听到动静”。",
          "type": "相遇"
        },
        "B5": {
          "beat_id": "B5",
          "dramatic_function": "暗示顾沉可能知晓或参与昨夜事件，并试图掩饰。",
          "emotion_change": "顾沉的回避引发林晚进一步怀疑。",
          "event": "顾沉在对话中眼神掠过暗房门口，并回避关于“动静”的深入询问。",
          "information_change": "顾沉对暗房区域表现出异常关注。",
          "type": "试探"
        },
        "B6": {
          "beat_id": "B6",
          "dramatic_function": "暗示顾沉也藏有秘密物品。",
          "emotion_change": "顾沉保持表面自然，但动作暴露紧张。",
          "event": "顾沉回答问题时，左手一直插在外套口袋里，口袋布料绷紧，似握有物品。",
          "information_change": "观众获知顾沉口袋藏有物品。",
          "type": "隐藏"
        },
        "B7": {
          "beat_id": "B7",
          "dramatic_function": "林晚直接试探，顾沉给出合理但可能虚假的解释。",
          "emotion_change": "林晚的怀疑未减；顾沉试图平息疑问。",
          "event": "林晚询问暗房灯未关及顾沉使用暗房情况，顾沉以“洗旧照片”、“客户急件”为由回应。",
          "information_change": "顾沉承认昨夜使用暗房，理由为洗照片。",
          "type": "调查"
        },
        "B8": {
          "beat_id": "B8",
          "dramatic_function": "引入关键视觉线索（灰外套照片），将顾沉与神秘人影联系起来。",
          "emotion_change": "林晚的怀疑得到视觉印证，警惕性提升。",
          "event": "顾沉进入暗房，林晚瞥见晾干绳上一张刚定影的照片，照片中是一个穿灰色外套的人影背对镜头站在小巷，外套款式与顾沉所穿相似。",
          "information_change": "林晚（及观众）看到灰外套照片，与顾沉产生关联。",
          "type": "发现"
        },
        "B9": {
          "beat_id": "B9",
          "dramatic_function": "顾沉主动试探林晚是否知晓照片内容或相关事件。",
          "emotion_change": "林晚以困惑否认；顾沉的试探未获信息。",
          "event": "顾沉从暗房出来后，询问林晚是否看到“穿灰外套的人”。",
          "information_change": "顾沉明确提及“灰外套”线索。",
          "type": "试探"
        },
        "B10": {
          "beat_id": "B10",
          "dramatic_function": "顾沉对林晚进行反试探，测试她是否发现或动了相册夹。",
          "emotion_change": "顾沉表面随意，实则紧张等待回答；林晚以无辜回应。",
          "event": "顾沉离开前，随口询问林晚是否动过储物柜里的相册夹。",
          "information_change": "顾沉确认相册夹是其关注点。",
          "type": "压力测试"
        },
        "B11": {
          "beat_id": "B11",
          "dramatic_function": "揭示林晚隐藏的秘密（旧照片），并建立“灰外套”与林晚过去的直接联系。",
          "emotion_change": "林晚表情冰冷，意识到顾沉记得此事。",
          "event": "顾沉离开后，林晚从毛衣口袋掏出一张对折的旧照片，展开后显示一个年轻女人（林晚）穿着灰色外套站在照相馆门口，背面写着“1998.10.3。回声照相馆。林晚。”",
          "information_change": "观众获知林晚藏有自己穿灰外套的旧照，时间地点明确。",
          "type": "揭示"
        }
      },

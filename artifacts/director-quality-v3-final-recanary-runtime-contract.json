      "beats": {
        "1": {
          "beat_id": "1",
          "dramatic_function": "引入关键物证，暗示暗房内曾发生可疑事件。",
          "emotion_change": "营造悬疑、不祥的氛围。",
          "event": "工作台上放着一个打开的牛皮纸档案袋，露出泛黄老照片一角，旁边散落着边缘有细微锯齿状撕裂痕迹的剪下胶片。",
          "information_change": "观众首次看到档案袋和可疑胶片边缘。",
          "type": "视觉证明引入"
        },
        "2": {
          "beat_id": "2",
          "dramatic_function": "展示林晚的表面伪装，为后续冲突铺垫。",
          "emotion_change": "强化林晚的懒散表象。",
          "event": "林晚以刻意慵懒、漫不经心的态度工作，将显影好的模糊人影照片夹到晾干绳上。",
          "information_change": "无。",
          "type": "公开面具节拍"
        },
        "3": {
          "beat_id": "3",
          "dramatic_function": "暗示林晚对档案袋有隐藏的关注或秘密。",
          "emotion_change": "引发对林晚真实意图的怀疑。",
          "event": "林晚在夹照片时，目光快速扫过档案袋，指尖极轻地划过袋口，随即收回。",
          "information_change": "观众察觉林晚行为中的细微异常。",
          "type": "隐藏层泄露种子"
        },
        "4": {
          "beat_id": "4",
          "dramatic_function": "建立对峙，将冲突焦点锁定在物证上。",
          "emotion_change": "紧张感开始累积。",
          "event": "顾沉进入暗房，停在林晚身后，目光落在档案袋和胶片边缘上。",
          "information_change": "顾沉开始介入调查。",
          "type": "场景冲突视觉锚点"
        },
        "5": {
          "beat_id": "5",
          "dramatic_function": "通过门锁问题试探林晚，引发初步防御反应。",
          "emotion_change": "林晚从懒散转向轻微紧张。",
          "event": "顾沉询问林晚昨晚是否锁好暗房门，并提及门锁有松动痕迹；林晚以懒散语气回应，但擦手动作微顿。",
          "information_change": "透露门锁可能被动过，林晚反应异常。",
          "type": "对话冲突"
        },
        "6": {
          "beat_id": "6",
          "dramatic_function": "暗示林晚身上可能藏有物品，与失踪底片相关。",
          "emotion_change": "加深对林晚的怀疑。",
          "event": "林晚说“没丢什么贵重东西”时，右手无意识碰了碰T恤下摆的硬质凸起轮廓，随即抚平。",
          "information_change": "观众注意到林晚的隐藏动作。",
          "type": "隐藏层泄露种子"
        },
        "7": {
          "beat_id": "7",
          "dramatic_function": "直接质问胶片来源，迫使林晚给出解释。",
          "emotion_change": "林晚表现出不耐烦，但内心紧绷。",
          "event": "顾沉拿起档案袋，询问底片是否由林晚整理；林晚声称是旧废片并剪了边角准备扔掉。",
          "information_change": "林晚提供关于胶片的初步说辞。",
          "type": "对话冲突"
        },
        "8": {
          "beat_id": "8",
          "dramatic_function": "展示林晚用表面情绪掩盖真实反应。",
          "emotion_change": "林晚的防御姿态增强。",
          "event": "林晚以惯常的懒散抱怨语气质问顾沉是否在审问她，但身体微微绷紧。",
          "information_change": "无。",
          "type": "公开面具节拍"
        },
        "9": {
          "beat_id": "9",
          "dramatic_function": "将冲突升级，触及林晚的记忆或秘密核心。",
          "emotion_change": "林晚从不耐烦转向恐惧和困惑。",
          "event": "顾沉暗示底片可能不是废片，并质问林晚是否“记得”是自己剪的；林晚瞳孔收缩，手指蜷缩掐掌心。",
          "information_change": "顾沉提出林晚可能失忆或隐瞒的假设。",
          "type": "对话冲突"
        },
        "10": {
          "beat_id": "10",
          "dramatic_function": "将怀疑直接指向林晚，迫使她做出更激烈的反应。",
          "emotion_change": "林晚的恐惧和愤怒达到高点。",
          "event": "顾沉进一步暗示失踪的关键底片可能未丢，而是被某人“保管”，并扫视林晚T恤下摆；林晚下意识捂住该位置。",
          "information_change": "顾沉明确将林晚与失踪底片联系起来。",
          "type": "对话冲突"
        },
        "11": {
          "beat_id": "11",
          "dramatic_function": "结束对峙，留下悬念和林晚的内心崩溃。",
          "emotion_change": "林晚从伪装彻底转向真实情绪的混乱。",
          "event": "顾沉离开暗房，提及下午有客人取照片，要求找出有用东西；林晚面具碎裂，露出困惑、恐惧和决绝，手悬在档案袋上颤抖。",
          "information_change": "顾沉给出最后通牒，林晚情绪彻底暴露。",
          "type": "场景结束"
        }
      },

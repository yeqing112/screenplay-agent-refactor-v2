# LLM Configuration (OpenAI-compatible API)
OPENAI_API_KEY=***
OPENAI_BASE_URL=http://10.126.126.2:11434/v1
LLM_MODEL=qwen3-max
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192

# ── Rate Limiting ──────────────────────────────────
LLM_RPM=10               # Max requests per minute
LLM_TPM=200000           # Max tokens per minute
LLM_DAILY_LIMIT=0        # Daily token cap (0=unlimited)
LLM_MIN_INTERVAL=1.0     # Min seconds between calls

# Embedding (Ollama)
OLLAMA_BASE_URL=http://192.168.43.2:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ChromaDB
CHROMA_PERSIST_DIR=./work/indexes/chroma

# SQLite
DATABASE_URL=sqlite:///./work/db/screenplay.db
# Director Runtime hard gate rollout (keep false until approved ShotPlan
# evidence is present for the target projects).
REQUIRE_SHOT_PLAN_BY_DEFAULT=false
DEPLOYMENT_ENV=development

# API hardening.  Leave the legacy node API on only while migrating old local clients.
# Development defaults only. Production must use real HTTPS origins (not
# localhost/example domains).
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_CORS_ALLOW_CREDENTIALS=false
ENABLE_LEGACY_NODE_API=true
# Optional production API guard. Keep disabled for local development. When
# enabled, use a random token of at least 32 characters and inject it via
# Authorization: Bearer, X-API-Key, or the configured cookie.
API_AUTH_ENABLED=false
API_AUTH_TOKEN=
API_AUTH_TOKEN_COOKIE=screenplay_api_token
API_AUTH_EXEMPT_PATHS=/health
# Optional role tokens (JSON object; every token must be >=32 characters).
# viewer: GET/HEAD, editor: viewer + write methods, admin: all API methods.
API_AUTH_ROLE_TOKENS=
# Optional in-process API backstop.  Production should also enforce a
# distributed limit at the reverse proxy when running multiple workers.
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_IDENTITIES=10000
# Set true only after a shared/reverse-proxy limiter is configured. The
# application limiter above is single-process and cannot satisfy this alone.
API_RATE_LIMIT_DISTRIBUTED_ASSERTED=false

# Public asset storage for external video providers
# Keep QINIU_ACCESS_KEY / QINIU_SECRET_KEY only in your local .env.
PUBLIC_ASSET_STORAGE_PROVIDER=qiniu
PUBLIC_ASSET_LOCAL_BASE_URL=http://127.0.0.1:18765
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=ai-ku01
QINIU_REGION=z2
# Temporary 七牛测试域名 is HTTP-only and expires; replace with HTTPS custom CDN domain for production.
QINIU_PUBLIC_BASE_URL=http://tkgj4ur0t.hn-bkt.clouddn.com
QINIU_BUCKET_PRIVATE=true
QINIU_KEY_PREFIX=screenplay-agent
QINIU_UPLOAD_TOKEN_EXPIRES_SECONDS=3600
QINIU_PUBLIC_URL_TTL_SECONDS=86400
